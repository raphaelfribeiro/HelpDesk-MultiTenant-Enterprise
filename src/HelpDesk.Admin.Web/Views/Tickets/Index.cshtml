@model List<HelpDesk.Admin.Web.Models.TicketViewModel>

<h2>Tickets Dashboard</h2>

<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Status</th>
            <th>Criado em</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Title</td>
                <td>@t.Status</td>
                <td>@t.CreatedAt</td>
            </tr>
        }
    </tbody>
</table>