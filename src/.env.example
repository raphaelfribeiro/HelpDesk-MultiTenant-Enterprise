# Copy to .env (gitignored) and fill in values for local docker-compose runs.
# Do NOT commit .env. Real values belong in user-secrets (local dev) or
# Azure Key Vault (production).

# SQL Server sa password used by the helpdesk-sql container.
SQL_SA_PASSWORD=

# Connection string used by the API to reach SQL Server.
# Example (matches the sqlserver service above):
# Server=sqlserver,1433;Database=HelpDesk;User Id=sa;Password=${SQL_SA_PASSWORD};TrustServerCertificate=True
DB_CONNECTION_STRING=

# Azure Service Bus connection string consumed by the notification worker.
SERVICEBUS_CONNECTION_STRING=
