    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ad21c942-1538-4dbb-8439-586727ff272b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
